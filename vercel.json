{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)\\.php",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/paso-uno.php",
      "destination": "/pago-form.html"
    },
    {
      "source": "/get-redirect.php",
      "destination": "/api/generar-pago"
    },
    {
      "source": "/api/get-redirect.php",
      "destination": "/api/generar-pago"
    },
    {
      "source": "/api-guardar-pse.php",
      "destination": "/api/generar-pago"
    }
  ]
}
